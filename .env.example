PUBLIC_PB_URL=https://your-pocketbase-instance.com

# Database
# SQLite for local development (no server needed)
DATABASE_URL=file:./local.db
# For production with PostgreSQL, uncomment and set:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/capital

# Better Auth
BETTER_AUTH_SECRET=your-random-secret-here
BETTER_AUTH_URL=http://localhost:3000

# OIDC Provider (Solian)
SOLIAN_CLIENT_ID=your-solian-client-id
SOLIAN_CLIENT_SECRET=your-solian-client-secret

# Seed first admin (use: /auth/login?setup=<this-secret>)
SEED_ADMIN_SECRET=your-random-secret-here
