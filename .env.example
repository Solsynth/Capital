PUBLIC_PB_URL=https://your-pocketbase-instance.com

# Database (PostgreSQL required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/capital

# Better Auth
BETTER_AUTH_SECRET=your-random-secret-here
BETTER_AUTH_URL=http://localhost:3000

# OIDC Provider (Solian / Solarpass)
SOLIAN_CLIENT_ID=your-solian-client-id
SOLIAN_CLIENT_SECRET=your-solian-client-secret

# Admin emails (comma-separated). Users with these emails are auto-promoted to admin on login.
# When unset in dev, all users are admins.
ADMIN_EMAILS=admin@solsynth.dev

# Cloudflare R2 (S3-compatible storage)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET=capital
R2_KEY_PREFIX=capital
R2_PUBLIC_URL=https://pub-xxx.r2.dev  # or your custom domain

# DistributionCenter release catalog
# The production API is mounted at https://api.solian.app/dist.
DISTRIBUTION_API_BASE_URL=https://api.solian.app/dist
# Optional fallback for products without `distributionProductId` in Nuxt Content.
DISTRIBUTION_PRODUCT_ID=

# GitHub App (for CLA bot)
GITHUB_APP_ID=your-github-app-id
GITHUB_APP_PRIVATE_KEY_PATH=./keys/github-app.pem
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret
GITHUB_APP_INSTALLATION_ID=your-github-app-installation-id

# Dev: skip contribution refresh cooldown
CONTRIB_SKIP_COOLDOWN=1

# GoatCraft Minecraft plugin HTTP API (GET /v1/stats)
# Base URL without trailing slash, e.g. http://127.0.0.1:8080 or https://playmc.solsynth.dev:8080
NUXT_GOATCRAFT_API_URL=
# Optional. Leave empty for non-authorized / open API mode (no Authorization header).
# Set only if the plugin requires a Bearer token.
NUXT_GOATCRAFT_API_TOKEN=
